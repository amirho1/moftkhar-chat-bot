# Node 22.12+; copy/setup never overwrites an existing .env.
# Native defaults use dedicated localhost ports, not existing databases.
PUBLIC_ORIGIN=http://localhost:3080
PORT=3080
BIND_HOST=127.0.0.1
DOCSGPT_MANAGEMENT_URL=http://127.0.0.1:7091
CHAT_BACKEND_URL=http://127.0.0.1:7091
CHAT_ENABLED=false
POSTGRES_URI=postgresql://chatbot:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:55432/chatbot
POSTGRES_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:56379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/1
CACHE_REDIS_URL=redis://127.0.0.1:56379/2
REDIS_URL=redis://127.0.0.1:56379/3
JWT_SECRET_KEY=
ENCRYPTION_SECRET_KEY=
INTERNAL_KEY=
CHAT_SESSION_SECRET=
DOCSGPT_MANAGEMENT_TOKEN=
DOCSGPT_USER=starter-operator
# Optional reviewed existing source ID when knowledge names are duplicated.
DOCSGPT_SOURCE_ID=
CHAT_AGENT_KEY=
AUTH_TYPE=simple_jwt
DEPLOYMENT_TYPE=production
DEFAULT_CHAT_TOOLS=none
AGENT_TRUSTED_ORIGINS=none
VECTOR_STORE=faiss
EMBEDDINGS_NAME=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDINGS_THREADS=1
# Local ONNX forwards one chunk at a time to bound peak memory.
EMBEDDINGS_MODEL_BATCH_SIZE=1
EMBEDDINGS_BATCH_SIZE=4
DOCSGPT_WORKER_MEMORY=2g
# Set an authorized provider locally in this file; never paste it into AI chat.
LLM_PROVIDER=openai
OPENAI_BASE_URL=
API_KEY=
LLM_NAME=
# Optional mounted operator model catalog. Its api_key_env can name your secret.
# In catalog mode leave OPENAI_BASE_URL empty to preserve catalog capabilities.
MODELS_CONFIG_DIR=
TRACES_CAPTURE_CONTENT=false
TRACES_OTEL_EXPORT=false
TRACES_RETENTION_DAYS=7
DECISION_ANALYTICS_ENABLED=false
LLM_CACHE_ENABLED=false
WEB_MAX_PAGES=100
MARKUP_MAX_BYTES=2000000
# Do not trust client-controlled forwarded headers. Configure only after an ingress audit.
CHAT_TRUSTED_IP_HEADER=
CHAT_SESSION_LIMIT=20
CHAT_IP_LIMIT=40
CHAT_GLOBAL_LIMIT=200
CHAT_CONCURRENCY=3
CHAT_STATE_PREFIX=starter
VERSION_CHECK=false
